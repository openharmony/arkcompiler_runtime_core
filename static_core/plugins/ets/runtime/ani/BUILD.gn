import("//build/ohos.gni")

config("ani_config") {
  include_dirs = [ "./" ]
}

ohos_shared_library("ani") {
  public_configs = [ ":ani_config" ]
  sources = []
  if (current_cpu == "arm64" && !is_mac && !is_mingw && !is_win && !is_debug) {
    version_script = "libani.map"
  }
  part_name = "runtime_core"
  subsystem_name = "arkcompiler"
}
