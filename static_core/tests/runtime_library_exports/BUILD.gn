import("//arkcompiler/runtime_core/static_core/ark_config.gni")
import("//build/test.gni")

# Device binary only: do not use ark_unittest's host-toolchain runner.
if (!ark_standalone_build && !ark_static_standalone_build && is_ohos &&
    current_cpu == "arm64" && !is_debug && !is_mac && !is_mingw && !is_win &&
    ark_ets_interop_js && enable_codegen) {
  ohos_unittest("runtime_library_exports_test") {
    sources = [ "runtime_library_exports_test.cpp" ]
    data_deps = [
      "${ark_root}/compiler:libarktscompiler",
      "${ark_root}/compiler/aot:libarkaotmanager",
      "${ark_root}/compiler/optimizer/code_generator:libarkencoder",
      "${ark_root}/plugins/ets/runtime/ani",
      "${ark_root}/plugins/ets/runtime/libani_helpers:ani_helpers",
    ]
    libs = [ "dl" ]
    module_out_path = "runtime_core/static_core/runtime_library_exports"
  }
}
