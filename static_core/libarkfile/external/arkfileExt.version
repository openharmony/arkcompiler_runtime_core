/*
 * GNU ld version script for libarkfileExt.so.
 *
 * Whitelist mode: only the five `extern "C"` entry points are exported;
 * everything else (C++ internals of PandaFileExt, std:: string helpers,
 * CRT leaks) is hidden by `local: *`.
 *
 * The symbols are unmangled `extern "C"` names, so they are listed exactly
 * as declared in file_ext.h. They are consumed by libarksupport.so via
 * dlsym-by-name, so the symbol name itself is the ABI contract.
 */

{
    global:
        OpenPandafileFromMemoryExt;
        OpenPandafileFromFdExt;
        QueryMethodSymByOffsetExt;
        QueryMethodSymAndLineByOffsetExt;
        QueryAllMethodSymsExt;

    local:
        *;
};
